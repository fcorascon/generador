import React, { useState, useRef, useEffect, useCallback } from 'react';
import { Upload, Download, Type, Image as ImageIcon, Settings, RefreshCw, X, Move, MousePointer2, Bold, Italic, Layers, Trash2, Sparkles, FileMinus, ChevronLeft, ChevronRight, CheckSquare, Shadow } from 'lucide-react';

// Carga dinámica de librerías para generar ZIP y guardar archivos
const loadScript = (src) => {
  return new Promise((resolve, reject) => {
    if (document.querySelector(`script[src="${src}"]`)) {
      resolve();
      return;
    }
    const script = document.createElement('script');
    script.src = src;
    script.onload = resolve;
    script.onerror = reject;
    document.head.appendChild(script);
  });
};

// Carga de Google Fonts
const loadGoogleFonts = () => {
  if (document.getElementById('google-fonts-link')) return;
  const link = document.createElement('link');
  link.id = 'google-fonts-link';
  link.rel = 'stylesheet';
  link.href = 'https://fonts.googleapis.com/css2?family=Montserrat:wght@900&family=Poppins:wght@400;700&display=swap';
  document.head.appendChild(link);
};

export default function App() {
  const [image, setImage] = useState(null);
  const [imageDimensions, setImageDimensions] = useState({ width: 0, height: 0 });
  const [names, setNames] = useState("Nombre Ejemplo\nJuan Pérez\nMaría López\nJuan Pérez");
  const [settings, setSettings] = useState({
    x: 50,
    y: 50,
    fontSize: 40,
    color: '#FFFFFF',
    fontFamily: 'Poppins', 
    align: 'center',
    isBold: false,
    isItalic: false,
    showShadow: true,
    shadowColor: '#000000',
    shadowBlur: 8,
    shadowOffset: 4
  });
  
  const [previewIndex, setPreviewIndex] = useState(0);
  const [isProcessing, setIsProcessing] = useState(false);
  const [progress, setProgress] = useState(0);
  const [librariesLoaded, setLibrariesLoaded] = useState(false);
  const [isDragging, setIsDragging] = useState(false);
  const [dragOffset, setDragOffset] = useState({ x: 0, y: 0 });
  
  const previewCanvasRef = useRef(null);
  const textareaRef = useRef(null);

  const nameList = names.split('\n').map(n => n.trim()).filter(n => n !== '');

  useEffect(() => {
    if (nameList.length === 0) {
      setPreviewIndex(0);
    } else if (previewIndex >= nameList.length) {
      setPreviewIndex(Math.max(0, nameList.length - 1));
    }
  }, [names, nameList.length]);

  useEffect(() => {
    loadGoogleFonts();
    Promise.all([
      loadScript('https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js'),
      loadScript('https://cdnjs.cloudflare.com/ajax/libs/FileSaver.js/2.0.5/FileSaver.min.js')
    ]).then(() => {
      setLibrariesLoaded(true);
    }).catch(err => console.error("Error cargando librerías", err));
  }, []);

  const handleImageUpload = (e) => {
    const file = e.target.files[0];
    if (file) {
      const reader = new FileReader();
      reader.onload = (event) => {
        const img = new Image();
        img.onload = () => {
          setImage(img);
          setImageDimensions({ width: img.width, height: img.height });
          setSettings(prev => ({
            ...prev,
            x: img.width / 2,
            y: img.height / 2
          }));
        };
        img.src = event.target.result;
      };
      reader.readAsDataURL(file);
    }
  };

  const getFontString = (s) => {
    let fontString = '';
    if (s.isItalic) fontString += 'italic ';
    if (s.isBold && s.fontFamily !== 'Montserrat') fontString += 'bold ';
    const family = s.fontFamily === 'Montserrat' ? "'Montserrat', sans-serif" : 
                   s.fontFamily === 'Poppins' ? "'Poppins', sans-serif" : s.fontFamily;
    fontString += `${s.fontSize}px ${family}`;
    return fontString;
  };

  const applyShadowSettings = (ctx, s) => {
    if (s.showShadow) {
      ctx.shadowColor = s.shadowColor;
      ctx.shadowBlur = s.shadowBlur;
      ctx.shadowOffsetX = s.shadowOffset;
      ctx.shadowOffsetY = s.shadowOffset;
    } else {
      ctx.shadowColor = 'transparent';
      ctx.shadowBlur = 0;
      ctx.shadowOffsetX = 0;
      ctx.shadowOffsetY = 0;
    }
  };

  const drawPreview = useCallback(() => {
    if (!image || !previewCanvasRef.current) return;

    const canvas = previewCanvasRef.current;
    const ctx = canvas.getContext('2d');
    
    canvas.width = image.width;
    canvas.height = image.height;

    ctx.drawImage(image, 0, 0);

    document.fonts.ready.then(() => {
        ctx.font = getFontString(settings);
        ctx.fillStyle = settings.color;
        ctx.textAlign = settings.align;
        ctx.textBaseline = 'middle';
        applyShadowSettings(ctx, settings);
        const currentName = nameList.length > 0 ? nameList[previewIndex] : "Vista Previa";
        ctx.fillText(currentName, settings.x, settings.y);
    });
    
  }, [image, nameList, settings, isDragging, previewIndex]); 

  useEffect(() => {
    drawPreview();
  }, [drawPreview]);

  const getMousePos = (canvas, evt) => {
    const rect = canvas.getBoundingClientRect();
    const scaleX = canvas.width / rect.width;
    const scaleY = canvas.height / rect.height;
    return {
      x: (evt.clientX - rect.left) * scaleX,
      y: (evt.clientY - rect.top) * scaleY
    };
  };

  const isMouseOverText = (ctx, x, y, text) => {
    const metrics = ctx.measureText(text);
    const width = metrics.width;
    const height = settings.fontSize;
    let startX = settings.x;
    if (settings.align === 'center') startX = settings.x - width / 2;
    if (settings.align === 'right') startX = settings.x - width;
    const startY = settings.y - height / 2;
    const padding = 20;
    return (x >= startX - padding && x <= startX + width + padding && y >= startY - padding && y <= startY + height + padding);
  };

  const handleMouseDown = (e) => {
    const canvas = previewCanvasRef.current;
    if (!canvas || !image) return;
    const pos = getMousePos(canvas, e);
    const ctx = canvas.getContext('2d');
    ctx.font = getFontString(settings);
    const currentName = nameList.length > 0 ? nameList[previewIndex] : "Vista Previa";
    if (isMouseOverText(ctx, pos.x, pos.y, currentName)) {
      setIsDragging(true);
      setDragOffset({ x: pos.x - settings.x, y: pos.y - settings.y });
    }
  };

  const handleMouseMove = (e) => {
    const canvas = previewCanvasRef.current;
    if (!canvas || !image) return;
    const pos = getMousePos(canvas, e);
    const ctx = canvas.getContext('2d');
    ctx.font = getFontString(settings);
    const currentName = nameList.length > 0 ? nameList[previewIndex] : "Vista Previa";
    if (isDragging || isMouseOverText(ctx, pos.x, pos.y, currentName)) {
      canvas.style.cursor = 'move';
    } else {
      canvas.style.cursor = 'default';
    }
    if (isDragging) {
      setSettings(prev => ({ ...prev, x: pos.x - dragOffset.x, y: pos.y - dragOffset.y }));
    }
  };

  const handleMouseUp = () => setIsDragging(false);

  const nextPreview = () => { if (previewIndex < nameList.length - 1) setPreviewIndex(prev => prev + 1); };
  const prevPreview = () => { if (previewIndex > 0) setPreviewIndex(prev => prev - 1); };

  const cleanUpList = () => {
    const cleaned = names.split('\n').map(line => line.trim()).filter(line => line.length > 0).join('\n');
    setNames(cleaned);
  };

  const removeDuplicates = () => {
    const lines = names.split('\n').map(l => l.trim()).filter(l => l.length > 0);
    const unique = [...new Set(lines)];
    setNames(unique.join('\n'));
  };

  const clearAllNames = () => {
    if (window.confirm('¿Estás seguro de que quieres borrar toda la lista de nombres?')) setNames('');
  };
  
  const selectAllNames = () => {
    if (textareaRef.current) {
        textareaRef.current.focus();
        textareaRef.current.setSelectionRange(0, textareaRef.current.value.length);
        try {
            document.execCommand('selectAll', false, null);
        } catch (e) {}
    }
  };

  const handleGenerate = async () => {
    if (!librariesLoaded || !image) return;
    setIsProcessing(true);
    setProgress(0);
    const finalNameList = names.split('\n').map(n => n.trim()).filter(n => n !== '');
    const total = finalNameList.length;
    if (total === 0) {
      alert("Por favor ingresa al menos un nombre.");
      setIsProcessing(false);
      return;
    }
    const zip = new window.JSZip();
    const canvas = document.createElement('canvas');
    canvas.width = image.width;
    canvas.height = image.height;
    const ctx = canvas.getContext('2d');
    await document.fonts.ready;

    for (let i = 0; i < total; i++) {
      const name = finalNameList[i];
      ctx.clearRect(0, 0, canvas.width, canvas.height);
      ctx.drawImage(image, 0, 0);
      ctx.font = getFontString(settings);
      ctx.fillStyle = settings.color;
      ctx.textAlign = settings.align; 
      ctx.textBaseline = 'middle';
      applyShadowSettings(ctx, settings);
      ctx.fillText(name, settings.x, settings.y);
      const blob = await new Promise(resolve => canvas.toBlob(resolve, 'image/png'));
      const safeName = name.replace(/[^a-z0-9]/gi, '_').toLowerCase();
      zip.file(`${safeName}_${i}.png`, blob);
      setProgress(Math.round(((i + 1) / total) * 100));
      await new Promise(r => setTimeout(r, 10));
    }
    const content = await zip.generateAsync({ type: "blob" });
    window.saveAs(content, "imagenes_generadas.zip");
    setIsProcessing(false);
    setProgress(0);
  };

  return (
    <div className="min-h-screen bg-slate-50 text-slate-800 font-sans">
      <header className="bg-indigo-600 text-white p-4 shadow-md">
        <div className="max-w-7xl mx-auto flex items-center justify-between">
          <div className="flex items-center gap-2">
            <RefreshCw className="w-6 h-6" />
            <h1 className="text-xl font-bold">Generador Masivo de Imágenes</h1>
          </div>
          <div className="text-xs bg-indigo-700 px-3 py-1 rounded-full">
             {librariesLoaded ? "Sistema Listo" : "Cargando recursos..."}
          </div>
        </div>
      </header>

      {}
      <main className="max-w-7xl mx-auto p-4 grid grid-cols-1 lg:grid-cols-3 gap-6 mt-4">
        
        {}
        <div className="lg:col-span-1 space-y-6">
          
          {}
          <div className="bg-white p-5 rounded-xl shadow-sm border border-slate-200">
            <h2 className="flex items-center gap-2 font-semibold text-lg mb-4 text-indigo-600"><ImageIcon className="w-5 h-5" />1. Plantilla</h2>
            <div className="border-2 border-dashed border-slate-300 rounded-lg p-6 text-center hover:bg-slate-50 transition-colors relative">
              <input type="file" accept="image/*" onChange={handleImageUpload} className="absolute inset-0 w-full h-full opacity-0 cursor-pointer" />
              <div className="flex flex-col items-center">
                <Upload className="w-8 h-8 text-slate-400 mb-2" />
                <span className="text-sm text-slate-500 font-medium">{image ? "Cambiar imagen" : "Clic para subir imagen"}</span>
              </div>
            </div>
          </div>

          {}
          <div className="bg-white p-5 rounded-xl shadow-sm border border-slate-200">
            <div className="flex justify-between items-end mb-3">
              <h2 className="flex items-center gap-2 font-semibold text-lg text-indigo-600"><Type className="w-5 h-5" />2. Lista</h2>
              {names.length > 0 && (
                <div className="flex gap-1">
                  <button onClick={selectAllNames} className="text-[10px] flex flex-col items-center gap-0.5 text-slate-500 hover:text-indigo-600 hover:bg-indigo-50 px-2 py-1 rounded transition-all"><CheckSquare className="w-4 h-4" />Todo</button>
                  <button onClick={cleanUpList} className="text-[10px] flex flex-col items-center gap-0.5 text-slate-500 hover:text-indigo-600 hover:bg-indigo-50 px-2 py-1 rounded transition-all"><Sparkles className="w-4 h-4" />Pulir</button>
                  <button onClick={removeDuplicates} className="text-[10px] flex flex-col items-center gap-0.5 text-slate-500 hover:text-indigo-600 hover:bg-indigo-50 px-2 py-1 rounded transition-all"><FileMinus className="w-4 h-4" />Únicos</button>
                  <button onClick={clearAllNames} className="text-[10px] flex flex-col items-center gap-0.5 text-slate-500 hover:text-red-500 hover:bg-red-50 px-2 py-1 rounded transition-all"><Trash2 className="w-4 h-4" />Borrar</button>
                </div>
              )}
            </div>
            <textarea ref={textareaRef} className="w-full h-40 p-3 border border-slate-300 rounded-lg focus:ring-2 focus:ring-indigo-500 text-sm resize-none font-mono" placeholder="Ingresa un nombre por línea..." value={names} onChange={(e) => setNames(e.target.value)}></textarea>
            <div className="flex justify-between items-center mt-2 text-xs text-slate-400"><span>Un nombre por línea</span><span>{nameList.length} detectados</span></div>
          </div>

          {}
          <div className="bg-white p-5 rounded-xl shadow-sm border border-slate-200">
            <h2 className="flex items-center gap-2 font-semibold text-lg mb-4 text-indigo-600"><Settings className="w-5 h-5" />3. Estilos</h2>
            <div className="space-y-4">
              
              {}
              <div>
                <label className="text-xs font-semibold text-slate-500 uppercase block mb-1">Tamaño Fuente</label>
                <input type="range" min="10" max="250" value={settings.fontSize} onChange={(e) => setSettings({...settings, fontSize: parseInt(e.target.value)})} className="w-full accent-indigo-600" />
                <div className="text-right text-xs text-slate-500">{settings.fontSize}px</div>
              </div>
              
              {}
              <div className="grid grid-cols-2 gap-4">
                <div>
                  <label className="text-xs font-semibold text-slate-500 uppercase block mb-1">Color</label>
                  <input type="color" value={settings.color} onChange={(e) => setSettings({...settings, color: e.target.value})} className="h-8 w-full rounded cursor-pointer border border-slate-200" />
                </div>
                <div>
                    <label className="text-xs font-semibold text-slate-500 uppercase block mb-1">Alineación</label>
                    <select value={settings.align} onChange={(e) => setSettings({...settings, align: e.target.value})} className="w-full p-1 border border-slate-300 rounded text-sm">
                      <option value="center">Centro</option>
                      <option value="left">Izquierda</option>
                      <option value="right">Derecha</option>
                    </select>
                </div>
              </div>

              {}
              <div>
                <label className="text-xs font-semibold text-slate-500 uppercase block mb-1">Fuente</label>
                <select value={settings.fontFamily} onChange={(e) => setSettings({...settings, fontFamily: e.target.value})} className="w-full p-2 border border-slate-300 rounded text-sm font-medium">
                  <option value="Poppins" style={{fontFamily: 'Poppins'}}>Poppins (Elegante)</option>
                  <option value="Montserrat" style={{fontFamily: 'Montserrat', fontWeight: 900}}>Montserrat Black (Gruesa)</option>
                  <option value="Arial">Arial</option>
                  <option value="Verdana">Verdana</option>
                  <option value="Times New Roman">Times New Roman</option>
                </select>
              </div>

              {}
              {/* SECCIÓN DE SOMBRA ACTUALIZADA */}
              <div className="p-3 bg-slate-50 rounded-lg border border-slate-200 space-y-3">
                <div className="flex items-center justify-between">
                  <label className="text-xs font-bold text-slate-600 uppercase flex items-center gap-2">
                    <Layers className="w-3 h-3 text-indigo-500" />
                    Sombra de Texto
                  </label>
                  <button 
                    onClick={() => setSettings(p => ({...p, showShadow: !p.showShadow}))}
                    className={`text-[10px] px-2 py-0.5 rounded-full font-bold transition-colors ${settings.showShadow ? 'bg-indigo-600 text-white' : 'bg-slate-300 text-slate-600'}`}
                  >
                    {settings.showShadow ? 'ACTIVA' : 'INACTIVA'}
                  </button>
                </div>

                {settings.showShadow && (
                  <div className="space-y-3 pt-1">
                    <div className="flex items-center gap-3">
                      <input type="color" value={settings.shadowColor} onChange={(e) => setSettings({...settings, shadowColor: e.target.value})} className="h-6 w-10 rounded cursor-pointer" />
                      <span className="text-[10px] text-slate-400 font-mono uppercase">Color de Sombra</span>
                    </div>
                    
                    <div>
                      <div className="flex justify-between text-[10px] text-slate-500 mb-1">
                        <span>DIFUMINADO (Blur)</span>
                        <span>{settings.shadowBlur}px</span>
                      </div>
                      <input type="range" min="0" max="30" value={settings.shadowBlur} onChange={(e) => setSettings({...settings, shadowBlur: parseInt(e.target.value)})} className="w-full accent-indigo-500 h-1.5" />
                    </div>

                    <div>
                      <div className="flex justify-between text-[10px] text-slate-500 mb-1">
                        <span>DISTANCIA (Offset)</span>
                        <span>{settings.shadowOffset}px</span>
                      </div>
                      <input type="range" min="0" max="20" value={settings.shadowOffset} onChange={(e) => setSettings({...settings, shadowOffset: parseInt(e.target.value)})} className="w-full accent-indigo-500 h-1.5" />
                    </div>
                  </div>
                )}
              </div>

              {}
              <div className="flex gap-2">
                <button onClick={() => setSettings(p => ({...p, isBold: !p.isBold}))} className={`flex-1 p-2 rounded border text-sm transition-all ${settings.isBold ? 'bg-indigo-600 text-white border-indigo-600 shadow-md' : 'bg-white'}`}><Bold className="w-4 h-4 inline mr-1" />Negrita</button>
                <button onClick={() => setSettings(p => ({...p, isItalic: !p.isItalic}))} className={`flex-1 p-2 rounded border text-sm transition-all ${settings.isItalic ? 'bg-indigo-600 text-white border-indigo-600 shadow-md' : 'bg-white'}`}><Italic className="w-4 h-4 inline mr-1" />Cursiva</button>
              </div>
            </div>
          </div>
        </div>

        {}
        <div className="lg:col-span-2 flex flex-col gap-4">
          <div className="bg-white p-5 rounded-xl shadow-sm border border-slate-200 flex-grow flex flex-col min-h-[500px]">
            <div className="flex justify-between items-center mb-4">
              <h2 className="flex items-center gap-2 font-semibold text-lg text-indigo-600"><Move className="w-5 h-5" />Vista Previa Interactiva</h2>
              <div className="text-[10px] text-slate-400 bg-slate-100 px-2 py-1 rounded">Los cambios se aplican en tiempo real</div>
            </div>
            
            {}
            <div className="flex-grow bg-slate-100 rounded-lg border border-slate-200 relative flex items-center justify-center overflow-auto select-none">
              {!image ? (
                <div className="text-center text-slate-400"><ImageIcon className="w-16 h-16 mx-auto mb-2 opacity-30" /><p>Sube una imagen para comenzar</p></div>
              ) : (
                <div className="relative">
                   <canvas ref={previewCanvasRef} className="max-w-full h-auto shadow-lg touch-none cursor-move" style={{ maxHeight: '70vh' }} onMouseDown={handleMouseDown} onMouseMove={handleMouseMove} onMouseUp={handleMouseUp} onMouseLeave={handleMouseUp} />
                </div>
              )}
            </div>
            
            {}
            {image && nameList.length > 0 && (
              <div className="mt-4 p-3 bg-indigo-50 rounded-lg flex items-center justify-between border border-indigo-100">
                <div className="text-sm font-medium truncate max-w-[60%]"><span className="text-indigo-300 mr-2 font-bold uppercase text-[10px]">Previsualizando:</span>{nameList[previewIndex]}</div>
                <div className="flex items-center gap-2">
                    <button onClick={prevPreview} disabled={previewIndex === 0} className="p-1 bg-white border border-indigo-200 rounded shadow-sm disabled:opacity-30 hover:bg-indigo-50 transition-colors"><ChevronLeft /></button>
                    <span className="text-xs font-bold w-12 text-center text-indigo-700 font-mono">{previewIndex + 1}/{nameList.length}</span>
                    <button onClick={nextPreview} disabled={previewIndex === nameList.length - 1} className="p-1 bg-white border border-indigo-200 rounded shadow-sm disabled:opacity-30 hover:bg-indigo-50 transition-colors"><ChevronRight /></button>
                </div>
              </div>
            )}
          </div>
          
          {}
          <button onClick={handleGenerate} disabled={!image || nameList.length === 0} className={`w-full py-4 rounded-xl flex items-center justify-center gap-3 text-lg font-bold shadow-lg transition-all ${!image || nameList.length === 0 ? 'bg-slate-200 text-slate-400' : 'bg-indigo-600 hover:bg-indigo-700 text-white transform hover:-translate-y-1'}`}>
            {isProcessing ? `Procesando... ${progress}%` : <><Download className="w-6 h-6" />Descargar {nameList.length} Imágenes (ZIP)</>}
          </button>
        </div>
      </main>
    </div>
  );
}
